# Copy to .env for local runs:  cp .env.example .env
# Everything here has a sensible default, so .env is optional. Values already set in
# your shell (or by Kubernetes, Airflow, CI) always win over this file.

# Postgres from docker-compose.yml (owner role)
AGRI_DSN=postgresql://agri:agri@localhost:5432/agri

# Where fetched files land: data/raw/weather/dt=YYYY-MM-DD/open_meteo.json
AGRI_DATA_DIR=./data

# Open-Meteo endpoints. Leave unset for the real API. To work offline or when the
# free daily quota is used up, run `make fake-weather` and uncomment these:
# OPEN_METEO_ARCHIVE_URL=http://localhost:8090/v1/archive
# OPEN_METEO_FORECAST_URL=http://localhost:8090/v1/forecast
